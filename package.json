{
  "name": "fatum",
  "version": "1.2.0",
  "displayName": "Fatum",
  "description": "Generate random data",
  "main": "./dist/extension.js",
  "publisher": "dmytro-pustovit",
  "icon": ".docs/logo_128.jpg",
  "engines": {
    "vscode": "^1.78.0",
    "node": ">=10"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "fatum.domain",
        "category": "Fatum",
        "title": "Random: domain"
      },
      {
        "command": "fatum.email",
        "category": "Fatum",
        "title": "Random: email"
      },
      {
        "command": "fatum.firstName",
        "category": "Fatum",
        "title": "Random: firstName"
      },
      {
        "command": "fatum.fullName",
        "category": "Fatum",
        "title": "Random: fullName"
      },
      {
        "command": "fatum.int",
        "category": "Fatum",
        "title": "Random: integer"
      },
      {
        "command": "fatum.lastName",
        "category": "Fatum",
        "title": "Random: lastName"
      },
      {
        "command": "fatum.nickName",
        "category": "Fatum",
        "title": "Random: nickName"
      },
      {
        "command": "fatum.password",
        "category": "Fatum",
        "title": "Random: password"
      },
      {
        "command": "fatum.sentence",
        "category": "Fatum",
        "title": "Random: sentence"
      },
      {
        "command": "fatum.text",
        "category": "Fatum",
        "title": "Random: text"
      },
      {
        "command": "fatum.uniform",
        "category": "Fatum",
        "title": "Random: float"
      },
      {
        "command": "fatum.uuid",
        "category": "Fatum",
        "title": "Random: uuid"
      },
      {
        "command": "fatum.date",
        "category": "Fatum",
        "title": "Random: date as ISO string"
      }
    ]
  },
  "scripts": {
    "prepare": "husky install",
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "test-compile": "tsc -p ./",
    "test-watch": "tsc -watch -p ./",
    "pretest:e2e": "npm run test-compile",
    "test:lock": "lockfile-lint --path package-lock.json --validate-https --allowed-hosts npm",
    "test:lint": "eslint src tests --ext ts --no-error-on-unmatched-pattern",
    "test:security": "npm audit --production && npm run test:lock",
    "test:e2e": "node ./out/tests/runTest.js",
    "test:debt": "jscpd src --config .jscpd.json",
    "test": "npm run test:lint && npm run test:security && npm run test:e2e",
    "sort-deps": "npm remove --save example; npm remove --save-dev example",
    "semantic-release": "npx semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pustovitDmytro/fatum-vscode.git"
  },
  "author": "Dmytro Pustovit",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pustovitDmytro/fatum-vscode/issues"
  },
  "homepage": "https://github.com/pustovitDmytro/fatum-vscode#readme",
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/node": "^8.0.1",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.2",
    "@babel/plugin-proposal-optional-chaining": "^7.18.9",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/runtime": "^8.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/lint": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/estree": "^1.0.1",
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.78.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "chai": "^6.2.2",
    "chance": "^1.1.9",
    "conventional-changelog-eslint": "^6.1.0",
    "coveralls": "^3.1.1",
    "danger": "^14.0.7",
    "eslint": "^10.9.1",
    "eslint-config-incredible": "^2.4.2",
    "eslint-plugin-censor": "^1.5.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-mocha": "^12.0.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-scanjs-rules": "^0.2.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "74.0.0",
    "fs-extra": "^11.1.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jscpd": "^5.1.1",
    "lockfile-lint": "^5.0.1",
    "mocha": "^12.0.0",
    "mocha-junit-reporter": "^2.2.0",
    "node-package-tester": "^1.3.6",
    "nyc": "^18.0.0",
    "semantic-release": "^25.0.9",
    "semantic-release-telegram": "^1.6.0",
    "semantic-release-vsce": "^6.1.7",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.4.2",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2",
    "vsce": "^2.15.0",
    "vscode-test": "^1.6.1",
    "webpack": "^5.82.0",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "cottus": "1.11.0",
    "fatum": "1.2.0",
    "myrmidon": "1.8.1",
    "winston": "3.9.0",
    "winston-vscode": "1.0.0"
  }
}
